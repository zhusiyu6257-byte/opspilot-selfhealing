# 用法：cp .env.example .env 后填写本机真实值。
# 本文件只放「键名 + 占位值」，不写真实密码 / Token；.env 已被 .gitignore 排除。
# 放在项目根目录：docker compose 会读取，后端从自己的目录读 backend/.env，
# 两处账号密码必须一致，否则后端连不上数据库。
#
# 注意：compose 里所有变量都用了 ${VAR:-默认值} 形式，默认值与下面的占位值一致，
# 所以即使不创建 .env 也能跑起来；要改就在 .env 里改，两处同步修改。

# 固定项目名：与其他共用 Docker daemon 的项目隔离，down 时不会误伤
COMPOSE_PROJECT_NAME=opspilot

# OpsPilot 平台数据库（PostgreSQL，仅平台自身业务数据）
# 下面三个值与 backend/app/core/config.py 的默认值保持一致，避免漂移。
POSTGRES_DB=opspilot_db
POSTGRES_USER=opspilot_user
POSTGRES_PASSWORD=opspilot_password
POSTGRES_PORT=5432

# 缓存与异步任务队列（Redis）
REDIS_PORT=6379

# 服务端口（避开已被 k3d 占用的 8080 / 8090 / 16443）
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
VITE_API_BASE_URL=http://localhost:8000

# ── 本地 HTTPS 开关 ────────────────────────────────────────
# 这是「启动脚本开关」，不是 Python Settings 读取的键。
# 用法：OPSPILOT_HTTPS=1 bash scripts/start-dev.sh
# 首次会自动用 scripts/generate-dev-ca.sh 生成：
#   deploy/certs/ca.crt      本地 CA 根证书（服务端之间校验用，可导入浏览器信任根）
#   deploy/certs/dev.crt     后端证书（由上面的 CA 签发，含 localhost/127.0.0.1/host.docker.internal）
#   deploy/certs/dev.key     后端私钥（chmod 600，绝不外传）
# 浏览器仍会提示不受信任，因为系统不认识这个本地 CA；导入 ca.crt 即可消除。
# 服务端之间（Prometheus/Alertmanager 到后端）已用 ca.crt 做真正校验，不再跳过验证。
# 生产必须换可信 CA 签发的证书。
OPSPILOT_HTTPS=0

# ── Alertmanager Webhook 鉴权 ───────────────────────────────
# 后端由 pydantic-settings 读取，不是 compose 变量。
# 注意：uvicorn 从 backend/ 目录启动时，env_file=".env" 解析到的是
# backend/.env，所以开发值要写到 backend/.env（该文件同样被 gitignore）。
# 生产请用高熵随机值；Alertmanager 侧用 credentials_file 挂载同一个值，
# 不要把 Token 明文写进 alertmanager.yml（配置常被提交/采集）。
# 留空 = fail closed：Webhook 返回 503，而不是对全网开放。
ALERT_WEBHOOK_TOKEN=replace-with-a-random-token
# 仅本地调试的显式逃生舱，生产保持 false
ALERT_WEBHOOK_ALLOW_INSECURE=false

# 同一条告警的「冷却时间」：这段时间内重复推送的自愈请求会被跳过，
# 不再重复远程执行命令。0 = 关掉这个功能。
# 建议设得比 alertmanager.yml 里的 repeat_interval 小：告警一直没好时，
# 隔一段时间仍允许再自愈一次，而不是永远不再执行。
ALERT_HEAL_COOLDOWN_SECONDS=600

# SSH 主机身份校验：默认只连接指纹已登记的可信主机。
# 生产应先通过带外渠道核对指纹，再写入 known_hosts；
# 不要直接把 AutoAddPolicy 当成长期方案。
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

# SSH 密码的对称加密主钥匙（Fernet 格式）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空 = 拒绝保存或传递密码（免密密钥登录不受影响）。
# 生产由密钥管理服务注入；不要提交仓库，也不要和数据库放在同一台机器上。
SSH_CREDENTIAL_KEY=
